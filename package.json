{
  "name": "woyaobeidanci",
  "version": "1.0.0",
  "private": true,
  "description": "我要背单词 —— 本地优先的跨端英语单词学习应用",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @woyao/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "verify:layout": "node dev/measure-layout.mjs",
    "icons": "node scripts/generate-app-icons.mjs",
    "package:win": "node scripts/package-win.mjs",
    "package:win:fast": "node scripts/package-win.mjs --skip-build",
    "package:exe": "node scripts/package-desktop.mjs --target=exe",
    "package:dmg": "node scripts/package-desktop.mjs --target=dmg",
    "package:dir": "node scripts/package-desktop.mjs --target=dir",
    "validate:assets": "vite-node --config vite.config.ts scripts/validate-assets.ts",
    "import:dictionary": "vite-node --config vite.config.ts scripts/import-dictionary.ts",
    "import:frequency": "vite-node --config vite.config.ts scripts/import-frequency.ts",
    "cloud:check": "vite-node --config vite.config.ts scripts/cloud-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@tencent-ai/workbuddy-cloud-sdk": "dev"
  }
}
