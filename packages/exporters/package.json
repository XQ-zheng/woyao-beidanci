{
  "name": "@woyao/exporters",
  "version": "0.1.0",
  "private": true,
  "description": "我要背单词的本地 Word、PDF、Excel 导出器",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "src",
    "fonts"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@woyao/services": "*",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.7",
    "pdfjs-dist": "^5.4.530"
  }
}
